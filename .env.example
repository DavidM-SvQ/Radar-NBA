# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Clave privada de acceso a /admin (OBLIGATORIA; mín. 8 caracteres).
# Sin credenciales por defecto en código: si no se define, el acceso /admin queda bloqueado (fail-closed).
ADMIN_PASSCODE=""

# ADMIN_TOKEN_SECRET: Secreto criptográfico de alta entropía para derivación scrypt y firma de sesiones.
# OBLIGATORIO en producción / Vercel (mín. 32 caracteres aleatorios, distinto de ADMIN_PASSCODE).
# Puedes generarlo con: openssl rand -hex 32
ADMIN_TOKEN_SECRET=""

# UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN / KV_REST_API_URL & KV_REST_API_TOKEN:
# Persistencia en la nube para liga Fantasy NBA y Rate Limiting distribuido en Vercel Serverless
# (bloqueos de fuerza bruta en /api/admin/login, inundación /admin y recargas pesadas ?refresh=1).
# Se inyectan automáticamente en Vercel al conectar "Upstash for Redis" en Storage.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


